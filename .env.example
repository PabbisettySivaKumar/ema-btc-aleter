# Copy this file to .env and fill in your real values.
# Never commit .env to git.

TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id_from_getUpdates

# Dead-man's switch (optional but recommended). Base ping URL of a
# healthchecks.io check, e.g. https://hc-ping.com/<uuid>. The alerter pings it
# on every successful cycle; if runs stop, healthchecks.io alerts you.
HEARTBEAT_URL=

# WhatsApp via Twilio (optional - leave blank to use Telegram only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
